---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import { client } from '../../lib/sanity'
import { CATEGORY_WITH_POSTS_QUERY, safeFetch, type CategoryWithPosts } from '../../lib/queries'
import { getCanonicalUrl, truncateText } from '../../lib/seo'

export const prerender = false

const { slug } = Astro.params
const category = await safeFetch<CategoryWithPosts | null>(client, CATEGORY_WITH_POSTS_QUERY, {
  slug: slug || '',
})

if (!category) {
  Astro.response.status = 404
}
---

{category ? (
  <Layout
    title={category.title}
    description={truncateText(category.description || `Posts about ${category.title}`, 160)}
    canonical={getCanonicalUrl(`/category/${slug}`)}
    type="website"
  >
    <section class="site-shell py-12 sm:py-16">
      <header class="mb-10 max-w-2xl">
        <p class="eyebrow">Explore a topic</p>
        <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight sm:text-5xl">{category.title}</h1>
        {category.description && (
          <p class="mt-4 text-lg leading-7 text-muted-foreground">{category.description}</p>
        )}
      </header>

      {category.posts.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {category.posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="rounded-2xl border border-dashed border-border bg-card px-6 py-12 text-center text-muted-foreground">
          No published articles in this topic yet.
        </p>
      )}
    </section>
  </Layout>
) : (
  <Layout
    title="Topic not found"
    description="This topic could not be found."
    canonical={getCanonicalUrl(`/category/${slug}`)}
    noIndex
  >
    <section class="site-shell py-24 text-center">
      <p class="eyebrow">404 — Topic not found</p>
      <h1 class="mt-4 font-serif text-4xl font-bold">That topic isn’t here.</h1>
      <a
        href="/blog/1/"
        class="mt-7 inline-flex rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground"
      >
        Browse articles
      </a>
    </section>
  </Layout>
)}
