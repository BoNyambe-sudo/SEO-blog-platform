---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import { client } from '../../lib/sanity'
import { CATEGORY_WITH_POSTS_QUERY, safeFetch } from '../../lib/queries'
import { getCanonicalUrl, truncateText } from '../../lib/seo'

export const prerender = false

const { slug } = Astro.params
const category = await safeFetch(client, CATEGORY_WITH_POSTS_QUERY, { slug })

if (!category) {
  return Astro.redirect('/404')
}
---

<Layout
  title={`${category.title} - SEO Blog Platform`}
  description={truncateText(category.description || `Posts about ${category.title}`, 160)}
  canonical={getCanonicalUrl(`/category/${slug}`)}
  type="website"
>
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl font-bold mb-4">{category.title}</h1>
      {category.description && (
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">{category.description}</p>
      )}

      {category.posts && category.posts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {category.posts.map((post: any) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-gray-600 dark:text-gray-400">No posts in this category yet.</p>
      )}
    </div>
  </section>
</Layout>
