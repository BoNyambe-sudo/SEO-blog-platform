---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import { client } from '../../lib/sanity'
import { AUTHOR_WITH_POSTS_QUERY, safeFetch } from '../../lib/queries'
import { getCanonicalUrl, truncateText } from '../../lib/seo'

export const prerender = false

const { slug } = Astro.params
const author = await safeFetch(client, AUTHOR_WITH_POSTS_QUERY, { slug })

if (!author) {
  return Astro.redirect('/404')
}
---

<Layout
  title={`${author.name} - SEO Blog Platform`}
  description={truncateText(author.bio || `Posts by ${author.name}`, 160)}
  canonical={getCanonicalUrl(`/author/${slug}`)}
  type="website"
>
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-start gap-6 mb-8">
        {author.image && (
          <img
            src={author.image.asset.url}
            alt={author.name}
            width={120}
            height={120}
            class="rounded-full"
          />
        )}
        <div>
          <h1 class="text-3xl font-bold mb-2">{author.name}</h1>
          {author.bio && (
            <p class="text-gray-600 dark:text-gray-400">{author.bio}</p>
          )}
          <div class="flex gap-4 mt-4">
            {author.twitter && (
              <a href={author.twitter} class="text-blue-600 hover:underline" target="_blank" rel="noopener">Twitter</a>
            )}
            {author.website && (
              <a href={author.website} class="text-blue-600 hover:underline" target="_blank" rel="noopener">Website</a>
            )}
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-bold mb-6">Posts by {author.name}</h2>

      {author.posts && author.posts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {author.posts.map((post: any) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-gray-600 dark:text-gray-400">No posts yet.</p>
      )}
    </div>
  </section>
</Layout>
