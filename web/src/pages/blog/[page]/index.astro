---
import Layout from '../../../layouts/Layout.astro'
import PostCard from '../../../components/PostCard.astro'
import { client } from '../../../lib/sanity'
import { POSTS_LIST_QUERY, POST_COUNT_QUERY, safeFetch, type PostCardData } from '../../../lib/queries'
import { getCanonicalUrl } from '../../../lib/seo'

export const prerender = true
export const revalidate = 3600

interface Props {
  page: number
  totalPages: number
  posts: PostCardData[]
}

export async function getStaticPaths() {
  const pageSize = 9
  const count = await safeFetch<number>(client, POST_COUNT_QUERY)
  const totalPages = Math.max(1, Math.ceil(count / pageSize))

  const paths = []
  for (let page = 1; page <= totalPages; page++) {
    const posts = await safeFetch<PostCardData[]>(client, POSTS_LIST_QUERY, {
      skip: (page - 1) * pageSize,
      limit: pageSize,
    })
    paths.push({
      params: { page: String(page) },
      props: { page, totalPages, posts },
    })
  }
  return paths
}

const { page, totalPages, posts } = Astro.props
const visiblePages = Array.from({ length: totalPages }, (_, index) => index + 1).filter(
  (number) => Math.abs(number - page) <= 2 || number === 1 || number === totalPages,
)
---

<Layout
  title={page === 1 ? 'All articles' : `Articles — page ${page}`}
  description="In-depth, practical guides to technical SEO, Core Web Vitals, content strategy, and modern web development."
  canonical={getCanonicalUrl(`/blog/${page}/`)}
  type="website"
>
  <section class="site-shell py-12 sm:py-16">
    <header class="mb-10 max-w-2xl">
      <p class="eyebrow">The complete library</p>
      <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight sm:text-5xl">All articles</h1>
      <p class="mt-4 text-lg leading-7 text-muted-foreground">
        Useful, considered guides for making the web easier to find, faster to use, and better to build.
      </p>
    </header>

    {posts.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-border bg-card px-6 py-12 text-center">
        <h2 class="font-serif text-xl font-bold">No articles here yet.</h2>
        <p class="mt-2 text-sm text-muted-foreground">Please check back soon for the latest field notes.</p>
      </div>
    )}

    {totalPages > 1 && (
      <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Article pages">
        {page > 1 && (
          <a
            href={`/blog/${page - 1}/`}
            class="rounded-xl border border-border px-4 py-2 text-sm font-medium transition hover:bg-muted"
            rel="prev"
          >
            Previous
          </a>
        )}
        {visiblePages.map((number) => (
          <a
            href={`/blog/${number}/`}
            class:list={[
              'grid size-10 place-items-center rounded-xl text-sm font-semibold transition',
              number === page
                ? 'bg-primary text-primary-foreground'
                : 'border border-border bg-card hover:bg-muted',
            ]}
            aria-current={number === page ? 'page' : undefined}
            aria-label={`Page ${number}`}
          >
            {number}
          </a>
        ))}
        {page < totalPages && (
          <a
            href={`/blog/${page + 1}/`}
            class="rounded-xl border border-border px-4 py-2 text-sm font-medium transition hover:bg-muted"
            rel="next"
          >
            Next
          </a>
        )}
      </nav>
    )}
  </section>
</Layout>
