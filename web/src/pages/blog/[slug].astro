---
import Layout from '../../layouts/Layout.astro'
import PortableTextRenderer from '../../components/PortableTextRenderer.astro'
import SocialShare from '../../components/SocialShare.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import { client } from '../../lib/sanity'
import { POST_BY_SLUG_QUERY, safeFetch, type PostDetail } from '../../lib/queries'
import { getCanonicalUrl, truncateText } from '../../lib/seo'
import { calculateReadTime, formatDate } from '../../lib/utils'

export const prerender = false

const slug = Astro.params.slug || ''

if (/^\d+$/.test(slug)) {
  return new Response(null, {
    status: 302,
    headers: { Location: `/blog/${slug}/` },
  })
}

const post = await safeFetch<PostDetail | null>(client, POST_BY_SLUG_QUERY, { slug })

if (!post) {
  Astro.response.status = 404
}

const canonical = getCanonicalUrl(`/blog/${slug}`)
const image = post?.coverImage?.asset?.url
  ? `${post.coverImage.asset.url}?auto=format&fit=max&w=1600&q=85`
  : '/og-default.svg'
---

{post ? (
  <Layout
    title={post.seoTitle || post.title}
    description={truncateText(post.seoDescription || post.excerpt || post.title, 160)}
    image={image}
    canonical={canonical}
    type="article"
    articleData={{
      publishedTime: post.publishedAt,
      modifiedTime: post._updatedAt,
      authors: post.author ? [post.author.name] : [],
      tags: post.categories?.map((category) => category.title) || [],
    }}
  >
    <article class="site-shell py-10 sm:py-14">
      <nav class="mb-8 text-xs font-medium text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="transition-colors hover:text-primary" href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="transition-colors hover:text-primary" href="/blog/1/">Articles</a></li>
          <li aria-hidden="true">/</li>
          <li class="max-w-56 truncate text-foreground" aria-current="page">{post.title}</li>
        </ol>
      </nav>

      <header class="mx-auto mb-9 max-w-3xl">
        {post.categories && post.categories.length > 0 && (
          <div class="mb-5 flex flex-wrap gap-2">
            {post.categories.map((category) => (
              <a
                href={`/category/${category.slug.current}`}
                class="rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-secondary-foreground transition hover:bg-primary hover:text-primary-foreground"
              >
                {category.title}
              </a>
            ))}
          </div>
        )}
        <h1 class="font-serif text-4xl font-bold leading-[1.08] tracking-[-0.035em] sm:text-5xl lg:text-6xl">
          {post.title}
        </h1>
        {post.excerpt && (
          <p class="mt-5 text-lg leading-8 text-muted-foreground sm:text-xl">{post.excerpt}</p>
        )}
        <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-3 border-y border-border py-4 text-sm text-muted-foreground">
          <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{calculateReadTime(post.content || [])} min read</span>
          {post.author && (
            <>
              <span aria-hidden="true">·</span>
              <a
                href={`/author/${post.author.slug.current}`}
                class="font-semibold text-foreground transition-colors hover:text-primary"
              >
                {post.author.name}
              </a>
            </>
          )}
        </div>
      </header>

      {post.coverImage?.asset?.url && (
        <figure class="mx-auto mb-12 max-w-5xl overflow-hidden rounded-2xl border border-border bg-muted">
          <img
            src={image}
            alt={post.coverImage.alt || post.title}
            width={post.coverImage.asset.metadata?.dimensions?.w || 1600}
            height={post.coverImage.asset.metadata?.dimensions?.h || 900}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="max-h-[36rem] w-full object-cover"
          />
        </figure>
      )}

      <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-14">
        <div class="min-w-0">
          <div class="lg:hidden">
            <TableOfContents content={post.content || []} />
          </div>
          <div class="prose max-w-none">
            <PortableTextRenderer value={post.content || []} />
          </div>
          <div class="mt-12 border-t border-border pt-6">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">
              Found this useful?
            </p>
            <SocialShare url={`/blog/${post.slug.current}`} title={post.title} />
          </div>
        </div>
        <aside class="hidden lg:block" aria-label="Article navigation">
          <TableOfContents content={post.content || []} />
        </aside>
      </div>
    </article>
  </Layout>
) : (
  <Layout
    title="Article not found"
    description="This article could not be found."
    canonical={canonical}
    noIndex
  >
    <section class="site-shell py-24 text-center">
      <p class="eyebrow">404 — Article not found</p>
      <h1 class="mt-4 font-serif text-4xl font-bold">This page has moved on.</h1>
      <p class="mt-3 text-muted-foreground">Try the latest articles instead.</p>
      <a
        href="/blog/1/"
        class="mt-7 inline-flex rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground"
      >
        Browse articles
      </a>
    </section>
  </Layout>
)}
