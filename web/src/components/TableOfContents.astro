---
import { getContentHeadings } from '../lib/utils'

interface Props {
  content: Parameters<typeof getContentHeadings>[0]
}

const headings = getContentHeadings(Astro.props.content)
---

{headings.length > 0 && (
  <>
    <details class="mb-8 rounded-2xl border border-border bg-card p-4 lg:hidden">
      <summary class="cursor-pointer list-none text-sm font-semibold">
        On this page
        <span class="float-right text-muted-foreground" aria-hidden="true">+</span>
      </summary>
      <nav class="mt-3" aria-label="Table of contents">
        <ul class="space-y-2 border-l border-border pl-3">
          {headings.map((heading) => (
            <li class={heading.level === 3 ? 'pl-3' : undefined}>
              <a
                href={`#${heading.id}`}
                class="text-sm leading-5 text-muted-foreground transition-colors hover:text-primary"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <nav class="hidden lg:sticky lg:top-28 lg:block" aria-label="Table of contents">
      <h2 class="eyebrow text-[0.65rem]">On this page</h2>
      <ul class="mt-4 space-y-2 border-l border-border pl-3">
        {headings.map((heading) => (
          <li class={heading.level === 3 ? 'pl-3' : undefined}>
            <a
              href={`#${heading.id}`}
              class="text-sm leading-5 text-muted-foreground transition-colors hover:text-primary"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </>
)}
