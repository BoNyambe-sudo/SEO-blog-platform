---
import { PortableText } from 'astro-portabletext'
import Callout from './Callout.astro'
import CodeBlock from './CodeBlock.astro'
import ContentHeading from './ContentHeading.astro'
import ContentLink from './ContentLink.astro'
import SanityImage from './SanityImage.astro'
import YouTubeEmbed from './YouTubeEmbed.astro'
import { getContentHeadings } from '../lib/utils'

interface ContentBlock {
  _type: string
  _key?: string
  style?: string
  children?: { text?: string }[]
  [key: string]: unknown
}

interface Props {
  value: ContentBlock[]
}

const { value } = Astro.props
const headings = getContentHeadings(value)
let headingIndex = 0
const contentWithHeadingIds = value.map((block) => {
  if (block._type !== 'block' || (block.style !== 'h2' && block.style !== 'h3')) return block
  const heading = headings[headingIndex]
  headingIndex += 1
  return { ...block, _headingId: heading?.id }
})

const components = {
  type: {
    code: CodeBlock,
    image: SanityImage,
    youtube: YouTubeEmbed,
    callout: Callout,
  },
  block: {
    h1: 'h2',
    h2: ContentHeading,
    h3: ContentHeading,
    h4: 'h4',
    normal: 'p',
    blockquote: 'blockquote',
  },
  list: {
    bullet: 'ul',
    number: 'ol',
  },
  mark: {
    link: ContentLink,
    strong: 'strong',
    em: 'em',
    code: 'code',
  },
}
---

<PortableText value={contentWithHeadingIds} components={components} />
