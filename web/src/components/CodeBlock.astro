---
import { Code } from 'astro/components'

interface Props {
  node: {
    code: string
    language?: string
    filename?: string
  }
}

const { code, language = 'plaintext', filename } = Astro.props.node
const lineCount = code.split('\n').length
---

<figure class="my-8 overflow-hidden rounded-2xl border border-border bg-muted">
  {filename && (
    <figcaption class="flex items-center gap-2 border-b border-border px-4 py-3 font-mono text-xs text-muted-foreground">
      <span class="size-2 rounded-full bg-primary/60" aria-hidden="true"></span>
      {filename}
    </figcaption>
  )}
  <div class="relative" data-code-block>
    {lineCount > 8 && (
      <button
        class="absolute right-3 top-3 z-10 rounded-lg border border-white/15 bg-black/50 px-2.5 py-1.5 text-xs font-medium text-white transition hover:bg-black/70"
        type="button"
        data-copy-code
      >
        Copy code
      </button>
    )}
    <Code
      code={code}
      lang={language}
      theme={{
        light: 'github-light',
        dark: 'github-dark',
      }}
      wrapLines
      showLineNumbers={lineCount > 5}
    />
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.closest('[data-code-block]')?.querySelector('pre code')?.textContent || ''
      try {
        await navigator.clipboard.writeText(code)
        button.textContent = 'Copied'
      } catch (error) {
        console.error('Could not copy this code block:', error)
        button.textContent = 'Copy failed'
      }
      window.setTimeout(() => {
        button.textContent = 'Copy code'
      }, 2000)
    })
  })
</script>
