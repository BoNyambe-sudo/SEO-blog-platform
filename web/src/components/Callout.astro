---
import PortableTextRenderer from './PortableTextRenderer.astro'

interface Props {
  node: {
    type?: 'info' | 'warning' | 'danger' | 'success'
    title?: string
    content?: Parameters<typeof PortableTextRenderer>[0]['value']
  }
}

const { type = 'info', title } = Astro.props.node
const appearances = {
  info: 'border-primary/50 bg-primary/5 text-foreground',
  warning: 'border-accent-foreground/40 bg-accent text-accent-foreground',
  danger: 'border-destructive/50 bg-destructive/5 text-foreground',
  success: 'border-primary/50 bg-primary/5 text-foreground',
}
const appearance = appearances[type] || appearances.info
---

<aside class={`my-8 rounded-r-2xl border-l-4 p-5 ${appearance}`} aria-label={title || `${type} note`}>
  {title && <strong class="mb-2 block text-sm font-bold">{title}</strong>}
  <div class="text-sm leading-6">
    <PortableTextRenderer value={Astro.props.node.content || []} />
  </div>
</aside>
