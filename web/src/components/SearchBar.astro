<div class="relative min-w-0">
  <label class="sr-only" for="article-search">Search articles</label>
  <div class="relative">
    <svg
      class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      id="article-search"
      type="search"
      placeholder="Search..."
      autocomplete="off"
      aria-controls="search-results"
      aria-expanded="false"
      class="h-10 w-32 rounded-xl border border-input bg-card pl-9 pr-2 text-sm text-foreground shadow-sm outline-none transition placeholder:text-muted-foreground focus:border-ring focus:ring-2 focus:ring-ring/20 sm:w-48 sm:pr-12"
    />
    <kbd class="pointer-events-none absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-md border border-border bg-muted px-1.5 py-0.5 text-[0.65rem] text-muted-foreground sm:inline">
      Ctrl K
    </kbd>
  </div>
  <div
    id="search-results"
    class="absolute right-0 z-50 mt-2 hidden max-h-[min(70vh,28rem)] w-[min(21rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl border border-border bg-popover p-2 text-popover-foreground shadow-xl"
    role="region"
    aria-label="Search results"
  >
    <ul id="search-list" class="space-y-1" role="listbox" aria-label="Articles"></ul>
    <p id="search-empty" class="hidden px-3 py-5 text-sm text-muted-foreground" aria-live="polite"></p>
    <p id="search-hint" class="px-3 py-3 text-xs text-muted-foreground">
      Search article titles, topics, and summaries.
    </p>
  </div>
</div>

<script>
  interface SearchItem {
    id: string
    title: string
    slug: string
    excerpt: string
    publishedAt: string
    categories: string[]
  }

  const input = document.getElementById('article-search') as HTMLInputElement | null
  const resultsContainer = document.getElementById('search-results')
  const list = document.getElementById('search-list')
  const emptyState = document.getElementById('search-empty')
  const hint = document.getElementById('search-hint')
  let fuse: import('fuse.js').default<SearchItem> | null = null
  let indexPromise: Promise<import('fuse.js').default<SearchItem>> | null = null

  async function getFuse() {
    if (!indexPromise) {
      indexPromise = (async () => {
        const [fuseModule, response] = await Promise.all([
          import('fuse.js'),
          fetch('/blog/search.json'),
        ])
        if (!response.ok) {
          throw new Error(`Search index request failed with status ${response.status}`)
        }
        const items = (await response.json()) as SearchItem[]
        return new fuseModule.default(items, {
          keys: ['title', 'excerpt', 'categories'],
          threshold: 0.32,
          minMatchCharLength: 2,
        })
      })()
    }
    return indexPromise
  }

  function setOpen(open: boolean) {
    resultsContainer?.classList.toggle('hidden', !open)
    input?.setAttribute('aria-expanded', String(open))
  }

  function renderResults(items: SearchItem[], query: string) {
    if (!list || !emptyState || !hint) return

    list.replaceChildren()
    hint.classList.add('hidden')
    emptyState.classList.add('hidden')

    if (items.length === 0) {
      emptyState.textContent = `No articles found for “${query}”. Try a broader topic.`
      emptyState.classList.remove('hidden')
      setOpen(true)
      return
    }

    for (const item of items) {
      const entry = document.createElement('li')
      const link = document.createElement('a')
      const title = document.createElement('span')
      const excerpt = document.createElement('span')

      link.href = item.slug
      link.className =
        'block rounded-xl px-3 py-3 transition-colors hover:bg-muted focus-visible:bg-muted'
      title.className = 'block text-sm font-semibold leading-5'
      title.textContent = item.title
      excerpt.className = 'mt-1 line-clamp-2 block text-xs leading-5 text-muted-foreground'
      excerpt.textContent = item.excerpt
      link.append(title, excerpt)
      entry.append(link)
      list.append(entry)
    }

    setOpen(true)
  }

  input?.addEventListener('input', async () => {
    const query = input.value.trim()
    if (query.length < 2) {
      if (list && hint && emptyState) {
        list.replaceChildren()
        hint.classList.remove('hidden')
        emptyState.classList.add('hidden')
      }
      setOpen(query.length > 0)
      return
    }

    try {
      fuse ??= await getFuse()
      renderResults(
        fuse.search(query).slice(0, 6).map((result) => result.item),
        query,
      )
    } catch (error) {
      console.error('Article search could not be loaded:', error)
      if (emptyState) {
        emptyState.textContent = 'Search is temporarily unavailable. Please try again shortly.'
        emptyState.classList.remove('hidden')
      }
      setOpen(true)
    }
  })

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault()
      input?.focus()
      setOpen(true)
    }
    if (event.key === 'Escape') setOpen(false)
  })

  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !input?.parentElement?.parentElement?.contains(event.target)) {
      setOpen(false)
    }
  })

  input?.addEventListener('focus', () => {
    if (input.value.length > 0) setOpen(true)
  })
</script>
