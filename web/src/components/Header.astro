---
import DarkModeToggle from '../components/DarkModeToggle.astro'
import SearchBar from '../components/SearchBar.astro'
---

<header class="border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">
      SEO Blog Platform
    </a>
    <nav class="hidden md:flex items-center gap-6">
      <a href="/blog" class="text-sm hover:text-blue-600 dark:hover:text-blue-400">Blog</a>
      <a href="/category/seo" class="text-sm hover:text-blue-600 dark:hover:text-blue-400">SEO</a>
      <a href="/category/web-performance" class="text-sm hover:text-blue-600 dark:hover:text-blue-400">Performance</a>
    </nav>
    <div class="flex items-center gap-2">
      <SearchBar />
      <DarkModeToggle />
      <a href="/blog" class="text-sm px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700">
        Articles
      </a>
    </div>
  </div>
</header>
